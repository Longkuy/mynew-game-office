# Server port (Render/Railway sets PORT automatically)
PORT=3847
HOST=0.0.0.0

# Google Drive target folder ID (from https://drive.google.com/drive/folders/<FOLDER_ID>)
DRIVE_FOLDER_ID=your_google_drive_folder_id_here
DRIVE_FOLDER_NAME=Mynew game/

# Optional: Google Service Account JSON (raw one-line JSON or base64 encoded)
# Share your target Google Drive folder with the service account's client_email as Editor!
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional: Pre-configure AI model on the backend (or configure inside the web app Settings)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
